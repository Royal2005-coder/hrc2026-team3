{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ActionPlan",
  "description": "Instruction sent from Planner (Person 2) to Motion Primitive (Person 3). Every field is required — Person 3 must reject any plan missing a field.",
  "type": "object",
  "required": [
    "plan_id",
    "primitive",
    "object_id",
    "class_id",
    "object_pose_base",
    "target_bin",
    "bin_pose_base",
    "grasp_hint",
    "retry_policy",
    "timeout_s"
  ],
  "additionalProperties": false,
  "properties": {

    "plan_id": {
      "type": "string",
      "description": "Unique plan identifier. Format: plan_XXXX",
      "pattern": "^plan_[0-9]{4}$",
      "examples": ["plan_0001", "plan_0007"]
    },

    "primitive": {
      "type": "string",
      "description": "Which motion primitive Person 3 should execute",
      "enum": ["pick_place", "move_home", "re_grasp"],
      "examples": ["pick_place"]
    },

    "object_id": {
      "type": "string",
      "description": "ID of the object to pick, matching Person 1's object_id",
      "examples": ["obj_001"]
    },

    "class_id": {
      "type": "string",
      "description": "Object class — determines which bin it belongs to",
      "enum": ["part_A", "part_B"],
      "examples": ["part_A"]
    },

    "object_pose_base": {
      "type": "object",
      "description": "Object position and orientation in robot base frame",
      "required": ["position_m", "quaternion_xyzw"],
      "additionalProperties": false,
      "properties": {
        "position_m": {
          "type": "array",
          "description": "[x, y, z] in meters, robot base frame",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "examples": [[0.46, -0.15, 0.82]]
        },
        "quaternion_xyzw": {
          "type": "array",
          "description": "[x, y, z, w] rotation — must be unit quaternion (norm ≈ 1.0)",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "examples": [[0.0, 0.0, 0.707, 0.707]]
        }
      }
    },

    "target_bin": {
      "type": "string",
      "description": "Which bin the object should be placed into",
      "enum": ["bin_A", "bin_B"],
      "examples": ["bin_A"]
    },

    "bin_pose_base": {
      "type": "object",
      "description": "Bin position and orientation in robot base frame",
      "required": ["position_m", "quaternion_xyzw"],
      "additionalProperties": false,
      "properties": {
        "position_m": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "examples": [[0.55, 0.20, 0.80]]
        },
        "quaternion_xyzw": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "examples": [[0.0, 0.0, 0.0, 1.0]]
        }
      }
    },

    "grasp_hint": {
      "type": "object",
      "description": "How the gripper should orient and open to grab the object",
      "required": ["yaw_rad", "grasp_width_m", "approach_axis"],
      "additionalProperties": false,
      "properties": {
        "yaw_rad": {
          "type": "number",
          "description": "Gripper rotation around Z axis in radians. 0=no rotation, 1.57=90deg",
          "minimum": -3.1416,
          "maximum":  3.1416,
          "examples": [1.57, 0.0]
        },
        "grasp_width_m": {
          "type": "number",
          "description": "How wide to open the gripper in meters before closing",
          "minimum": 0.01,
          "maximum": 0.15,
          "examples": [0.045, 0.060]
        },
        "approach_axis": {
          "type": "string",
          "description": "Direction the gripper approaches the object from",
          "enum": ["z_down", "x_front", "y_side"],
          "examples": ["z_down"]
        }
      }
    },

    "retry_policy": {
      "type": "string",
      "description": "Which retry rule to apply if this plan fails (defined in retry_policy.yaml)",
      "enum": ["retry_once_slow", "retry_twice_slow", "no_retry", "abort"],
      "examples": ["retry_once_slow"]
    },

    "timeout_s": {
      "type": "number",
      "description": "Maximum seconds Person 3 may spend on this plan before TIMEOUT",
      "minimum": 1.0,
      "maximum": 60.0,
      "examples": [20.0]
    }
  }
}